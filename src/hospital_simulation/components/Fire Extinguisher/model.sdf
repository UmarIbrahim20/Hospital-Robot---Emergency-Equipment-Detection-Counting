<?xml version='1.0' ?>
<sdf version='1.6'>
  <model name='Fire Extinguisher'>
    <static>true</static>
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Artifact Proximity Detector</uri>
    </include>
    
    <link name='link'>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>model://Fire Extinguisher/meshes/extinguisher.dae</uri>
            <scale>2 2 2</scale> </mesh>
        </geometry>
      </collision>
      
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://Fire Extinguisher/meshes/extinguisher.dae</uri>
            <scale>1.5 1.5 1.5</scale> </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
